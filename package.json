{
  "name": "generate-pr-review-report",
  "version": "1.0.0",
  "description": "Generate a static, self-contained HTML report from an AI PR review JSON payload, or show it inside agent hosts as an MCP App.",
  "keywords": [
    "code-review",
    "pull-request",
    "ai",
    "report",
    "html",
    "cli",
    "github",
    "agent",
    "mcp",
    "mcp-app"
  ],
  "homepage": "https://github.com/MaximeBF2000/generate-pr-review-report#readme",
  "bugs": {
    "url": "https://github.com/MaximeBF2000/generate-pr-review-report/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximeBF2000/generate-pr-review-report.git"
  },
  "author": "MaximeBF2000",
  "license": "MIT",
  "type": "module",
  "bin": {
    "generate-pr-review-report": "./bin/generate-pr-review-report.js"
  },
  "files": [
    "bin",
    "src",
    "templates"
  ],
  "scripts": {
    "example": "cd examples/sample-repo && node ../../bin/generate-pr-review-report.js -i ../pr-482.json -o ../../out/review-report-pr-482.html && node ../../bin/generate-pr-review-report.js -i ../pr-728-clean.json -o ../../out/review-report-pr-728.html",
    "test": "node --test test/",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  }
}
